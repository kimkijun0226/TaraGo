# Public Data Portal — 일반 인증키(Decoding)
PUBLIC_DATA_SERVICE_KEY=

# Seoul Open Data Plaza — 서울시 지하철 실시간 도착정보 key
SEOUL_SUBWAY_REALTIME_ARRIVAL_API_KEY=

# Local PostgreSQL + PostGIS
DATABASE_URL=postgresql://tarago:tarago@localhost:5432/tarago

# 공공데이터포털 '국토교통부_전국 버스정류장 위치정보' CSV 파일 (정류장 적재 작업에서만 사용)
BUS_STATIONS_CSV_PATH=
# 공공데이터포털 제공 파일은 일반적으로 CP949 계열이며 Node에서는 euc-kr로 디코딩
BUS_STATIONS_CSV_ENCODING=euc-kr
# 잘못되거나 잘린 파일로 기존 정류장을 지우지 않도록 보호
BUS_STATIONS_MIN_ROWS=100000
